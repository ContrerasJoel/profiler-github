# Puerto en el que escucha la API.
PORT=3001

# Personal Access Token de GitHub (classic o fine-grained, sin scopes: solo lee datos públicos).
# Sube el rate limit de 60 a 5.000 peticiones/hora. Nunca sale del backend.
# Crear en: https://github.com/settings/tokens
GITHUB_TOKEN=

# Orígenes permitidos por CORS, separados por comas.
# En producción hay que añadir aquí la URL de Vercel.
CORS_ORIGINS=http://localhost:3000

# Segundos que un perfil permanece en la caché en memoria.
CACHE_TTL=300
